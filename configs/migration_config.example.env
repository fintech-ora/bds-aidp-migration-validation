# Copy to .env or source it in a shell before running the reusable scripts.
# Keep real credentials, private keys, and passwords out of Git.

# Run identity
MIGRATION_RUN_ID="bds_to_aidp_migration_YYYYMMDD"

# BDS / Hive source
BDS_CLUSTER_NAME="<bds-cluster-name>"
BDS_REGION="<oci-region>"
HIVE_DATABASES="<db1,db2>"
HIVE_TABLES=""
HIVE_USER="hive"
HIVE_BIN="hive"
HIVE_KEYTAB="/etc/security/keytabs/hive.service.keytab"
HIVE_PRINCIPAL="hive/$(hostname -f)@BDSCLOUDSERVICE.ORACLE.COM"
HIVE_KRB5CCNAME="/tmp/krb5cc_hive_${MIGRATION_RUN_ID}"

# HDFS export user
HDFS_USER="hdfs"
HDFS_BIN="hdfs"
HDFS_KEYTAB="/etc/security/keytabs/hdfs.headless.keytab"
HDFS_PRINCIPAL="<hdfs-principal>"
HDFS_KRB5CCNAME="/tmp/krb5cc_hdfs_${MIGRATION_RUN_ID}"

# Object Storage landing zone
OCI_REGION="<oci-region>"
OCI_PROFILE="<oci-profile>"
OCI_AUTH="api_key"
OBJECT_STORAGE_NAMESPACE="<namespace>"
OBJECT_STORAGE_BUCKET="<bucket>"
OBJECT_STORAGE_PREFIX="migrations/${MIGRATION_RUN_ID}"
BDS_EXPORT_TRANSFER_MODE="hdfs-oci"

# Required by BDS Hadoop connector when BDS Object Storage API key auth is used.
# Populate these from `oci bds bds-api-key get`; keep passphrases out of Git.
BDS_OSS_CLIENT_REGION="${OCI_REGION}"
BDS_OSS_CLIENT_AUTH_FINGERPRINT="<bds-api-key-fingerprint>"
BDS_OSS_CLIENT_AUTH_PEMFILEPATH="<path-on-bds-node>"
BDS_OSS_CLIENT_AUTH_TENANTID="<tenancy-ocid>"
BDS_OSS_CLIENT_AUTH_USERID="<user-ocid>"
BDS_OSS_CLIENT_AUTH_PASSPHRASE="<temporary-passphrase>"
HADOOP_OPTS="-DBDS_OSS_CLIENT_AUTH_FINGERPRINT=${BDS_OSS_CLIENT_AUTH_FINGERPRINT} -DBDS_OSS_CLIENT_AUTH_PASSPHRASE=${BDS_OSS_CLIENT_AUTH_PASSPHRASE} -DBDS_OSS_CLIENT_AUTH_PEMFILEPATH=${BDS_OSS_CLIENT_AUTH_PEMFILEPATH} -DBDS_OSS_CLIENT_AUTH_TENANTID=${BDS_OSS_CLIENT_AUTH_TENANTID} -DBDS_OSS_CLIENT_AUTH_USERID=${BDS_OSS_CLIENT_AUTH_USERID} -DBDS_OSS_CLIENT_REGION=${BDS_OSS_CLIENT_REGION}"

# AIDP target
AIDP_REGION="<oci-region>"
AIDP_WORKSPACE="<workspace-name>"
AIDP_COMPUTE="<compute-name>"
AIDP_TARGET_CATALOG="default"
AIDP_TARGET_SCHEMA="migration_${MIGRATION_RUN_ID}"
AIDP_REGISTRATION_METHOD="spark-sql"

# CSV defaults used when Hive metadata does not expose richer format details.
CSV_HEADER="true"
CSV_DELIMITER=","

# Optional temporary Bastion access plan inputs. Prefer private connectivity
# where available. Do not use 0.0.0.0/0 unless an approver explicitly accepts
# that temporary exposure.
BASTION_COMPARTMENT_ID="<compartment-ocid>"
BASTION_TARGET_SUBNET_ID="<subnet-ocid>"
BASTION_CLIENT_CIDR="<your-public-ip>/32"
BASTION_SSH_PUBLIC_KEY_FILE="~/.ssh/id_rsa.pub"
BDS_TARGET_PRIVATE_IP="<bds-utility-node-private-ip>"
BDS_TARGET_SSH_PORT="22"
LOCAL_SSH_FORWARD_PORT="22022"
